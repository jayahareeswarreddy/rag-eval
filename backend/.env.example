# All optional. The harness runs with none of these set.

# Answer generation. Without a key, answers are extractive (built only from
# retrieved spans) and therefore always grounded.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
# OPENAI_API_KEY=

# Index a local directory instead of the Python standard library.
# RAG_CORPUS_DIR=../some-repo

# Walk the whole stdlib (~875 docs) rather than the curated subset (~93).
RAG_STDLIB_FULL=1

# Chunking and retrieval defaults for the served index.
RAG_CHUNK_SIZE=1024
RAG_EMBEDDER=auto
